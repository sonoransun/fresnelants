# =============================================================================
# FresnelAnts ephemeral outputs
# =============================================================================
artifacts/
docs/stl/
docs/gerber/

# Mesh and PCB outputs anywhere — these are big and regeneratable.
*.stl
*.step
*.stp
*.gbr
*.drl

# Reference assets committed to docs/img/ are kept (override the global bans).
!docs/img/**/*.stl
!docs/img/**/*.step
!docs/img/**/*.stp
!docs/img/**/*.gbr
!docs/img/**/*.drl
