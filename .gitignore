# =============================================================================
build/
dist/
wheels/
share/python-wheels/
*.egg
*.egg-info/
.eggs/
MANIFEST
.installed.cfg
__pypackages__/          # PEP 582
pip-log.txt
pip-delete-this-directory.txt
# Lockfiles are intentionally tracked — uv.lock, poetry.lock, requirements*.txt
# stay in the repo so contributors get reproducible installs.

